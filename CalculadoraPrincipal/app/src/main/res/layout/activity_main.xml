<?xml version="1.0" encoding="utf-8"?>

<GridLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:columnCount="4"
    android:rowCount="6"
    android:useDefaultMargins="true"
    android:padding="30dp"
    android:layout_gravity="center">

    <TextView
        android:id="@+id/pantalla"
        android:layout_width="278dp"
        android:layout_height="65dp"
        android:layout_columnSpan="4"
        android:background="#D3D3D3"
        android:gravity="right|center_vertical"
        android:padding="10dp"
        android:text="0"
        android:textSize="25sp" />

    <Button android:id="@+id/boton7"
        android:text="7"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/boton8"
        android:text="8"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/boton9"
        android:text="9"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/botonDividir"
        android:text="/"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/boton4"
        android:text="4"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/boton5"
        android:text="5"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/boton6"
        android:text="6"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/botonMultiplicar"
        android:text="*"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/boton1"
        android:text="1"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/boton2"
        android:text="2"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/boton3"
        android:text="3"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/botonResta"
        android:text="-"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/botonPunto"
        android:text="."
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/botonIgual"
        android:text="="
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/botonSuma"
        android:text="+"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button android:id="@+id/boton0"
        android:text="0"
        android:layout_width="65dp"
        android:layout_height="55dp"/>

    <Button
        android:id="@+id/botonAC"
        android:text="AC"
        android:layout_width="130dp"
        android:layout_height="55dp"
        android:layout_columnSpan="2"/>

    <Button
        android:id="@+id/botonC"
        android:text="C"
        android:layout_width="130dp"
        android:layout_height="55dp"
        android:layout_columnSpan="2"/>

</GridLayout>
